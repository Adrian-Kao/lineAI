VITE_LIFF_ID=
VITE_AUTH_MODE=line
VITE_SKIP_TO_PUZZLE=false
VITE_PHOTO_COMPARE_MODE=mock
VITE_PHOTO_COMPARE_ENDPOINT=

# 本機開發可改為 mock：跳過 LIFF，使用固定假 profile（僅 dev build 生效）
# Vercel 必須設定 VITE_LIFF_ID 後重新部署；Developing、Review、Published 各自使用不同 LIFF ID。
# VITE_LIFF_ID 請填 Developers Console 顯示的 LIFF ID，不是 Channel ID，也不是完整 LIFF URL。
# 只想測拼圖時可將 VITE_SKIP_TO_PUZZLE 改為 true，完整測三項任務時保持 false。
# PHOTO_COMPARE_MODE=mock 僅供 DEMO；正式環境請改為 remote 並由後端端點處理影像比對。
